# ============================================================================
# EDUCOMPASS - ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git - it contains sensitive credentials!
# ============================================================================

# ============================================================================
# EMAIL CONFIGURATION (Gmail SMTP - Real Email Delivery)
# ============================================================================

# Gmail SMTP Setup:
# 1. Go to https://myaccount.google.com/
# 2. Click "Security" in left menu
# 3. Enable 2-Step Verification
# 4. Go to https://myaccount.google.com/apppasswords
# 5. Select "Mail" and your device
# 6. Click "Generate"
# 7. Copy the 16-character password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password-here
EMAIL_FROM=noreply@educompass.io
APP_URL=http://localhost:5173

# ============================================================================
# SUPABASE CONFIGURATION (Backend Database)
# ============================================================================

# Get these from Supabase Dashboard: https://supabase.com/dashboard
# Click your project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend Service Role Key (for server-side operations)
# ⚠️ IMPORTANT: Never expose this in frontend code!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# ============================================================================
# AI SERVICES CONFIGURATION
# ============================================================================

# Google Gemini API Key for AI content generation
# Get from: https://aistudio.google.com/app/apikeys
# Sign in → Create API Key → Copy the key
GEMINI_API_KEY=your-gemini-api-key-here

# YouTube API Key (optional, for transcript extraction)
# Get from: https://console.cloud.google.com/
# Enable YouTube Data API v3 → Create API Key
YOUTUBE_API_KEY=your-youtube-api-key-here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

NODE_ENV=development
PORT=3001
CLIENT_PORT=5173

# ============================================================================
# OPTIONAL: LOGGING AND DEBUGGING
# ============================================================================

LOG_EMAILS=true
LOG_DATABASE=false
DEBUG_MODE=false

# ============================================================================
# ALTERNATIVE EMAIL PROVIDERS
# ============================================================================
# Uncomment one of these if using a different provider

# --- SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key
# EMAIL_FROM=noreply@yourdomain.com

# --- Mailgun ---
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@your-domain.mailgun.org
# SMTP_PASS=your-mailgun-password
# EMAIL_FROM=noreply@your-domain.mailgun.org

# --- AWS SES ---
# SMTP_HOST=email-smtp.region.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-ses-smtp-username
# SMTP_PASS=your-ses-smtp-password
# EMAIL_FROM=noreply@yourdomain.com

# --- Ethereal (Testing Only - Not Recommended) ---
# ⚠️ WARNING: Ethereal Email doesn't send real emails!
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=fawn.leuschke@ethereal.email
# SMTP_PASS=c5eFc7HrFmwY7fQn9W

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# 1. RENAME THIS FILE:
#    mv .env.example .env

# 2. GET GMAIL APP PASSWORD:
#    - Go to https://myaccount.google.com/
#    - Enable 2-Factor Authentication if not already done
#    - Go to https://myaccount.google.com/apppasswords
#    - Select "Mail" and "Windows Computer" (or your device)
#    - Click "Generate"
#    - Copy the 16-character password

# 3. GET SUPABASE CREDENTIALS:
#    - Go to https://supabase.com/dashboard
#    - Select your project
#    - Click Settings → API
#    - Copy Project URL and Anon Key
#    - Also get Service Role Key

# 4. FILL IN VALUES:
#    - Replace all "your-..." placeholders with actual values
#    - Do NOT use quotes around values

# 5. RESTART SERVER:
#    npm run dev

# ============================================================================
# VERIFICATION
# ============================================================================

# To verify email setup works:
# node server/test-email.js

# Expected output:
# ✅ Email service connected successfully
# ✅ Share notification email sent to test@example.com
# 📧 Email preview: https://...

# ============================================================================
# SECURITY NOTES
# ============================================================================

# NEVER commit .env to Git repository
# NEVER share these credentials with anyone
# NEVER post .env file in forums or support channels
# Regenerate credentials if accidentally exposed
# Use different credentials for dev vs production

# .gitignore should contain:
# .env
# .env.local
# .env.*.local
